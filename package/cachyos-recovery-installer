function is_efi() {
    [[ -d /sys/firmware/efi/efivars ]]
}

# From systemd-boot-manager
function generate_cmdline() {
    local srcdev \
        srcdev_uuid \
        srcdev_partuuid \
        srcdev_fsroot \
        root_fstype \
        cryptdevice_uuid \
        zpool \
        zpool_device \
        top_level_uuid \
        options

    srcdev="$(findmnt -vno SOURCE /)"
    srcdev_uuid="$(findmnt -no UUID /)"
    srcdev_partuuid="$(findmnt -no PARTUUID /)"
    srcdev_fsroot="$(findmnt -no FSROOT /)"
    root_fstype="$(findmnt -no FSTYPE /)"

    if [[ "$srcdev" == "overlay" ]]; then
        echo "Your root is overlay, not possible to detect device" >&2
        return 1
    fi

    if [[ -n "$srcdev_uuid" ]]; then
        options="root=UUID=${srcdev_uuid}"
    elif [[ -n "$srcdev_partuuid" ]]; then
        options="root=PARTUUID=${srcdev_partuuid}"
    else
        options="root=${srcdev}"
    fi

    case "${root_fstype}" in
        zfs)
            options="zfs=${srcdev}"
            ;;
        btrfs)
            options+=" rootflags=subvol=${srcdev_fsroot}"
            ;;
    esac

    top_level_uuid="${srcdev_uuid}"

    if [[ "${root_fstype}" = "zfs" ]]; then
        zpool="${srcdev%%/*}"
        zpool_device="$(zpool status -LP "${zpool}" | grep "/dev/" | awk '{print $1}')"
        top_level_uuid="$(lsblk -no UUID "${zpool_device}")"
    fi

    while read -r devname devtype; do
        if [[ "$devtype" = "crypt" ]]; then
            cryptdevice_uuid="$(blkid -o value -s UUID \
                "$(cryptsetup status "${devname}" \
                    | grep device \
                    | awk '{print $2}'
                )"
            )"
            options+=" cryptdevice=UUID=${cryptdevice_uuid}:${devname} rd.luks.name=${cryptdevice_uuid}=${devname}"
            break
        fi
    done < <(lsblk -nslo NAME,TYPE /dev/disk/by-uuid/"${top_level_uuid}" 2>/dev/null)

    echo "${options}"
}

function find_recovery_entry() {
    local target_uuid="${1}"
    local target_path="${2}"
    local target_num="${3:-}"
    local uuid boot path num

    if ! output="$(efibootmgr 2>/dev/null)"; then
        echo "Failed to get efibootmgr output" >&2
        return 1
    fi

    while read -r line; do
        uuid="${line%%/*}"
        uuid="${uuid%,*}"
        uuid="${uuid%,*}"

        if [[ -n "$target_num" ]]; then
            num="${uuid##*\(}"
            num="${num%%,*}"
            [[ "${num}" == "${target_num}" ]] || continue
        fi

        uuid="${uuid##*,}"
        [[ "${uuid}" == "${target_uuid}" ]] || continue

        path=${line##*/}
        [[ "${path}" == "${target_path}" ]] || continue

        boot="${line%%$'*'*}"
        boot="${boot#Boot}"
        [[ "${boot}" =~ [A-F0-9]+ ]] || continue

        echo "${boot}" && return 0
    done <<< "$output"

    return 1
}

function find_esp_partition() {
    local esp

    while IFS= read -r target; do
        case "$target" in
            /boot|/boot/efi|/efi)
                esp="$target"
                break
                ;;
        esac
    done < <(findmnt --fstab \
        --types vfat \
        --tab-file /etc/fstab \
        --noheadings \
        --output TARGET || true
    )

    echo "${esp:-}"
}

function create_boot_entry() {
    local path="${1}"
    local esp="${2}"
    local device disk partition order uuid entry num=""

    if ! command -v efibootmgr &>/dev/null; then
        echo "efibootmgr not found, skipping creating EFI entry..."
        return 0
    fi

    while read -r source partuuid; do
        if [[ "$source" == /dev/* && -n "$partuuid" ]]; then
            device="${source}"

            # Truncate partition number for MBR
            if [[ $partuuid =~ ^[[:xdigit:]]{8}-([[:xdigit:]]{2})$ ]]; then
                uuid="$(printf '0x%x' "0x${partuuid%-*}")"
                num="$(printf '%d' "0x${BASH_REMATCH[1]}")"
            else
                uuid="${partuuid}"
            fi
            break
        fi
    done < <(findmnt -vno SOURCE,PARTUUID "${esp}" || true)

    if [[ -z "${uuid:-}" ]]; then
        echo "Failed to detect ESP partition UUID" >&2
        return 1
    fi

    # Entry already exists for current installation, nothing to do
    if [[ -n "$(find_recovery_entry "$uuid" "$path" "$num")" ]]; then
        return 0
    fi

    if [[ -z "${device:-}" ]]; then
        echo "Failed to detect ESP partition device" >&2
        return 1
    fi

    device="${device#/dev/}"

    if ! disk="$(readlink -f "/sys/class/block/${device}" 2>/dev/null)"; then
        echo "Failed to detect ESP disk device" >&2
        return 1
    fi

    disk="${disk%/*}"
    disk="${disk##*/}"

    if ! partition="$(cat "/sys/class/block/${device}/partition" 2>/dev/null)"; then
        echo "Failed to detect ESP partition number" >&2
        return 1
    fi

    if ! efibootmgr --create-only \
        --disk "/dev/${disk}" \
        --part "${partition}" \
        --loader "${path}" \
        --label 'CachyOS Recovery' \
        --unicode 1>/dev/null; then
        echo "Failed to execute efibootmgr" >&2
        return 1
    fi

    if ! order="$(efibootmgr 2>/dev/null | grep -Po "^BootOrder:\s+\K(.*)" || false)"; then
        echo "Failed to detect boot EFI order" >&2
        return 1
    fi

    if ! entry="$(find_recovery_entry "${uuid}" "${path}" "${num}")"; then
        echo "Failed to detect boot EFI entry" >&2
        return 1
    fi

    if ! efibootmgr -o "${order},${entry}" 1>/dev/null; then
        echo "Failed to append entry in boot order" >&2
        return 1
    fi

    return 0
}

function is_signing_needed() {
    local -i keys=0
    local status section

    if ! command -v sbctl &>/dev/null; then
        echo "sbctl is not installed, skipping signing..."
        return 1
    fi

    if ! status="$(sbctl status --json)"; then
        return 1
    fi

    if ! [[ "$status" =~ \"installed\"[[:space:]]*:[[:space:]]*true ]]; then
        echo "sbctl is not installed, skipping signing..."
        return 1
    fi

    if ! [[ "$status" =~ \"secure_boot\"[[:space:]]*:[[:space:]]*true ]]; then
        echo "Secure boot is not enabled, skipping signing..."
        return 1
    fi

    if ! [[ "$status" =~ \"setup_mode\"[[:space:]]*:[[:space:]]*false ]]; then
        echo "Setup mode is enrolled, skipping signing..."
        return 1
    fi

    while IFS= read -r line; do
        case "$line" in
            PK:|KEK:|DB:) section="${line%:}";;
            ' '*|$'\t'*)
                if [[ -n "$section" ]]; then
                    ((keys++))
                    section=
                fi
                ;;
            *) ;;
        esac
    done < <(sbctl list-enrolled-keys || true)

    if ((keys != 3)); then
        echo "No keys enrolled, skipping signing..."
        return 1
    fi

    return 0
}

function copy_image() {
    local src="${1}"
    local dest="${2}"
    local tmp filename

    if ! tmp="$(mktemp -d -t image.XXXXXX 2>&1)"; then
        echo "Failed to create temporary directory: ${tmp}" >&2
        return 1
    fi

    filename="${dest##*/}"

    if [[ -s "$dest" ]]; then
        if ! cp -- "${dest}" "${tmp}/${filename}"; then
            echo "Failed to save old image"
            rm -rf "${tmp}"
            return 1
        else
            rm -f "$dest"
        fi
    fi

    if ! install -m644 "${src}" "${dest}"; then
        rm -f "$dest"
        echo "Failed to copy cachyos-recovery ${src} in ESP partition" >&2
        if [[ -s "${tmp}/${filename}" ]]; then
            if ! cp -- "${tmp}/${filename}" "${dest}"; then
                echo "Failed to return old image back, it is left in '${tmp}/${filename}'" >&2
                return 1
            fi
        fi
        rm -rf "${tmp}" || true
        return 1
    fi

    rm -rf "${tmp}" || true

    return 0
}

function install_recovery_efi() {
    local source target esp cmdline tmp

    esp="$(find_esp_partition)"

    if [[ -z "${esp}" ]]; then
        echo "No ESP partition was found"
        return 1
    fi

    source="/usr/lib/cachyos-recovery/cachyos-recovery.efi"
    target="${esp}/EFI/Linux/cachyos-recovery.efi"

    if [[ ! -s "${source}" ]]; then
        echo "cachyos-recovery image not found, exit..." >&2
        return 1
    fi

    if [[ ! -d "${esp}/EFI/Linux" ]]; then
        mkdir -p "${esp}/EFI/Linux"
    fi

    # In case if package was upgraded due to pkgrel increase
    if ! cmp -s "$source" "$target"; then
        if ! copy_image "$source" "$target"; then
            echo "Failed to install cachyos-recovery image" >&2
            return 1
        fi

        if is_signing_needed; then
            if ! sbctl sign "${target}"; then
                echo "Failed to sign ${target}, UEFI Secure Boot may not accept it" >&2
            fi
        fi
    fi

    if ! mkdir -p "${target}.extra.d"; then
        echo "Failed to create addon directory for CachyOS recovery" >&2
        return 1
    fi

    if ! cmdline="$(generate_cmdline)" || [[ -z "$cmdline" ]]; then
        echo "Failed to generate recovery kernel command line" >&2
        return 1
    fi

    if ! tmp="$(mktemp -d -t addon.XXXXXX)"; then
        echo "Failed to create temp directory: ${tmp}"
        return 1
    fi

    if ! ukify build \
        --cmdline="${cmdline}" \
        --output="${tmp}/root.addon.efi"; then
        echo "Failed to generate command-line addon for CachyOS recovery image" >&2
        rm -rf "${tmp}"
        return 1
    fi

    if ! install -m644 "${tmp}/root.addon.efi" "${target}.extra.d/root.addon.efi.new"; then
        rm -rf "${tmp}"
        echo "Failed to copy cachyos-recovery root addon in ESP partition" >&2
        return 1
    fi

    rm -rf "${tmp}"

    if ! mv -f "${target}.extra.d/root.addon.efi.new" "${target}.extra.d/root.addon.efi"; then
        rm -f "${target}.extra.d/root.addon.efi.new"
        echo "Failed to install cachyos-recovery root addon" >&2
        return 1
    fi

    if is_signing_needed; then
        if ! sbctl sign "${target}.extra.d/root.addon.efi"; then
            echo "Failed to sign root addon, UEFI Secure Boot may not accept it" >&2
        fi
    fi

    # Add boot entry in Limine if it's used
    if command -v limine-entry-tool &>/dev/null && [[ -e "${esp}/EFI/limine/limine_x64.efi" ]]; then
        if ! limine-entry-tool --add-efi "CachyOS Recovery" "${target}" --overwrite --quiet; then
            echo "Failed to add boot entry in Limine, please do this manually" >&2
        fi
    fi

    if [[ -d /etc/grub.d && -d /boot/grub/x86_64-efi ]]; then
        if ! create_grub_entry_efi "$target" "$esp"; then
            echo "Failed to create GRUB entry" >&2
        fi
    fi

    target="${target#"${esp}"}"
    target="${target//\//\\}"

    if ! create_boot_entry "${target}" "${esp}"; then
        echo "Failed to create EFI boot entry" >&2
    fi

    return 0
}

function create_grub_entry_efi() {
    local target="${1}"
    local esp="${2}"
    local uuid esp_uuid

    while read -r uuid; do
        [[ -n "$uuid" ]] || continue
        if [[ ${uuid//-/} =~ ^[[:xdigit:]]{8,32}$ ]]; then
            esp_uuid="${uuid}"
        fi
    done < <(findmnt -vno UUID "${esp}" || true)

    if [[ -z "$esp_uuid" ]]; then
        echo "Failed to get UUID of ${esp}" >&2
        return 1
    fi

    target="${target#"${esp}"}"

    cat << EOF | install -Dm755 /dev/stdin /etc/grub.d/50-cachyos-recovery || return 1
#!/bin/sh
exec tail -n +3 \$0

# THIS ENTRY IS AUTO-GENERATED BY CACHYOS-RECOVERY, DO NOT TOUCH
menuentry 'CachyOS Recovery' --id=cachyos-recovery {
    load_video
    set gfxpayload=keep

    insmod fat
    insmod chain

    search --no-floppy --fs-uuid --set=root ${esp_uuid}
    chainloader ${target}
}
EOF

    if ! grub-mkconfig -o /boot/grub/grub.cfg; then
        echo "Failed to regenerate GRUB config" >&2
        return 1
    fi

    return 0
}

function create_grub_entry_bios() {
    local initrd="${1}"
    local vmlinuz="${2}"
    local cmdline uuid fstype subvol=""

    if ! cmdline="$(generate_cmdline)" || [[ -z "$cmdline" ]]; then
        echo "Failed to generate recovery kernel command line" >&2
        return 1
    fi

    if ! uuid="$(findmnt -no UUID /)"; then
        echo "Failed to get UUID of root" >&2
        return 1
    fi

    if ! fstype="$(findmnt -no FSTYPE /)"; then
        echo "Failed to detect root fstype" >&2
        return 1
    fi

    [[ "$fstype" == "btrfs" ]] && subvol="/@"

    cat << EOF | install -Dm755 /dev/stdin /etc/grub.d/50-cachyos-recovery || return 1
#!/bin/sh
exec tail -n +3 \$0

# THIS ENTRY IS AUTO-GENERATED BY CACHYOS-RECOVERY, DO NOT TOUCH
menuentry 'CachyOS Recovery' --id=cachyos-recovery {
    load_video
    set gfxpayload=keep
    search --no-floppy --fs-uuid --set=root ${uuid}
    linux ${subvol}${vmlinuz} ${cmdline}
    initrd ${subvol}${initrd}
}
EOF

    if ! grub-mkconfig -o /boot/grub/grub.cfg; then
        echo "Failed to regenerate GRUB config" >&2
        return 1
    fi

    return 0
}

function install_recovery_bios() {
    local initrd vmlinuz

    initrd="/usr/lib/cachyos-recovery/cachyos-recovery.initrd"
    vmlinuz="/usr/lib/cachyos-recovery/cachyos-recovery.vmlinuz"

    if ! [[ -s "$initrd"  && -s "$vmlinuz" ]]; then
        echo "Failed to find initrd images" >&2
        return 1
    fi

    target_initrd="/boot/${initrd##*/}"
    target_vmlinuz="/boot/${vmlinuz##*/}"

    if command -v limine-entry-tool &>/dev/null && [[ -s "/boot/limine-bios.sys" ]]; then
        if ! limine-entry-tool --add-kernel "cachyos-recovery" "${vmlinuz}" "${initrd}" \
            --comment "CachyOS Recovery" --quiet; then
            echo "Failed to install boot entry in Limine, please do this manually" >&2
            return 1
        fi
    else
        if ! cmp -s "$vmlinuz" "$target_vmlinuz"; then
            copy_image "$vmlinuz" "$target_vmlinuz" || false
        fi

        if ! cmp -s "$initrd" "$target_initrd"; then
            copy_image "$initrd" "$target_initrd" || false
        fi
    fi

    if [[ -d /etc/grub.d && -d /boot/grub/i386-pc ]]; then
        if ! create_grub_entry_bios "$target_initrd" "$target_vmlinuz"; then
            echo "Failed to create GRUB entry" >&2
        fi
    fi

    return 0
}

function remove_recovery_efi() {
    local esp entry uuid path num=""

    esp="$(find_esp_partition)"

    if [[ -z "${esp}" ]]; then
        echo "No ESP partition was found, is not possible to remove recovery" >&2
        return 1
    fi

    path="${esp}/EFI/Linux/cachyos-recovery.efi"

    if [[ -e "${path}" ]]; then
        rm "${path}" || echo "Failed to remove recovery image"
    fi

    if [[ -d "${path}.extra.d" ]]; then
        rm -r "${path}.extra.d" || echo "Failed to remove addon directory"
    fi

    if command -v limine-entry-tool &>/dev/null && [[ -e "${esp}/EFI/limine/limine_x64.efi" ]]; then
        limine-entry-tool --remove-efi-path "${path}" --quiet
    fi

    if [[ -e /etc/grub.d/50-cachyos-recovery ]]; then
        rm /etc/grub.d/50-cachyos-recovery || echo "Failed to remove recovery GRUB entry" >&2
        grub-mkconfig -o /boot/grub/grub.cfg || echo "Failed to regenerate GRUB config" >&2
    fi

    if ! uuid="$(findmnt -vno PARTUUID "${esp}")"; then
        echo "Failed to detect partition UUID to remove boot entry" >&2
        return 0
    fi

    # Truncate partition number for MBR
    if [[ $uuid =~ ^[[:xdigit:]]{8}-([[:xdigit:]]{2})$ ]]; then
        uuid="$(printf '0x%x' "0x${uuid%-*}")"
        num="$(printf '%d' "0x${BASH_REMATCH[1]}")"
    fi

    path="${path#"${esp}"}"
    path="${path//\//\\}"

    if ! entry="$(find_recovery_entry "${uuid}" "${path}" "${num}")"; then
        return 0
    fi

    if ! efibootmgr -b "${entry}" -B 1>/dev/null; then
        echo "Failed to remove recovery '${entry}' entry from UEFI" >&2
        return 1
    fi

    return 0
}

function remove_recovery_bios() {
    rm /boot/cachyos-recovery.initrd || echo "Failed to remove recovery initrd" >&2
    rm /boot/cachyos-recovery.vmlinuz || echo "Failed to remove recovery vmlinuz" >&2

    if [[ -e /etc/grub.d/50-cachyos-recovery ]]; then
        rm /etc/grub.d/50-cachyos-recovery || echo "Failed to remove recovery GRUB entry" >&2
        grub-mkconfig -o /boot/grub/grub.cfg || echo "Failed to regenerate GRUB config" >&2
    fi

    if command -v limine-entry-tool &>/dev/null && [[ -s "/boot/limine-bios.sys" ]]; then
        limine-entry-tool --remove-all "cachyos-recovery" --quiet
    fi
}

if [[ "${1:-}" == "install" ]]; then
    if is_efi; then
        install_recovery_efi
    else
        install_recovery_bios
    fi
elif [[ "${1:-}" == "remove" ]]; then
    if [[ -e "/usr/lib/cachyos-recovery/cachyos-recovery.efi" ]]; then
        remove_recovery_efi
    else
        remove_recovery_bios
    fi
fi
