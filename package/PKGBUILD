# Maintainer: Vasiliy Stelmachenok <ventureo@cachyos.org>
pkgbase=cachyos-recovery
pkgname=('cachyos-recovery' 'cachyos-recovery-legacy')
pkgver=2026.11.23
pkgrel=1
url="https://github.com/CachyOS/cachyos-recovery"
license=(GPL-3.0-or-later)
arch=('any')
source=(
    "cachyos-recovery.efi::https://github.com/CachyOS/cachyos-recovery/releases/download/${pkgver}/cachyos-recovery_${pkgver}.efi"
    "cachyos-recovery.initrd::https://github.com/CachyOS/cachyos-recovery/releases/download/${pkgver}/cachyos-recovery_${pkgver}.initrd"
    "cachyos-recovery.vmlinuz::https://github.com/CachyOS/cachyos-recovery/releases/download/${pkgver}/cachyos-recovery_${pkgver}.vmlinuz"
    cachyos-recovery-installer
    95-recovery-install.hook
)
sha256sums=(
    '006fa6151e1fe6a8f62b5a220bc5fad348fc146a5ccd9d14f0f040533e0a1d5a'
    'f14c0d5d9843a4e69da07af228a5888b483b8945e45a43bb2021a3ee34472817'
    'b9a79d6f1d0f1f625a257fb78e305dd9ee19ea9a6315ba06489204e004e0b4c3'
    '7aab99deeba37789321c00f9519f671c39022921fcaa9b671da8c6f6c56b5f89'
    '5c3d60ef76ccc3604743dd9f4f9ddb859873b869efcedc77d2ed4c3e37e81803'
)

package_cachyos-recovery() {
    pkgdesc="CachyOS recovery image (UEFI)"
    depends=('systemd-ukify')
    provides=('cachyos-recovery')
    conflicts=('cachyos-recovery-legacy')

    install -Dm644 cachyos-recovery.efi "$pkgdir/usr/lib/cachyos-recovery/cachyos-recovery.efi"
    install -Dm755 cachyos-recovery-installer "$pkgdir/usr/share/libalpm/scripts/cachyos-recovery-installer"
    install -Dm644 95-recovery-install.hook "$pkgdir/usr/share/libalpm/hooks/95-recovery-install.hook"
}

package_cachyos-recovery-legacy() {
    pkgdesc="CachyOS recovery image (BIOS)"
    provides=('cachyos-recovery')
    conflicts=('cachyos-recovery')

    install -Dm644 cachyos-recovery.initrd "$pkgdir/usr/lib/cachyos-recovery/cachyos-recovery.initrd"
    install -Dm644 cachyos-recovery.vmlinuz "$pkgdir/usr/lib/cachyos-recovery/cachyos-recovery.vmlinuz"
    install -Dm755 cachyos-recovery-installer "$pkgdir/usr/share/libalpm/scripts/cachyos-recovery-installer"
    install -Dm644 95-recovery-install.hook "$pkgdir/usr/share/libalpm/hooks/95-recovery-install.hook"
}
