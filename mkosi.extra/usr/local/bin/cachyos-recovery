set -euo pipefail

## Messages

declare -r BTRFS_BOOT_SNAPSHOT_LABEL=$'Boot Btrfs snapshot'
declare -r BTRFS_BOOT_SNAPSHOT_DESC=$'Boot the system from a selected Btrfs snapshot.\nRecommended choice if available, after boot you will be prompted rollback selected snapshot.'
declare -r BTRFS_ROLLBACK_SNAPSHOT_LABEL=$'Rollback Btrfs snapshot'
declare -r BTRFS_ROLLBACK_SNAPSHOT_DESC=$'Restore the system from the selected Btrfs snapshot.\nSuitable if you know exactly which snapshot works or if snapshot cannot be loaded due to kexec.'
declare -r SYSTEM_REBOOT_LABEL=$'Reboot'
declare -r SYSTEM_REBOOT_DESC=$'Reboot the system'
declare -r EXIT_LABEL=$'Exit'
declare -r EXIT_DESC=$'Exit from cachyos-recovery to emergency shell'
declare -r RECOVERY_HEADER=$'Welcome to the CachyOS recovery menu!\nIf you are here, your system is probably broken, right? :(\nHow I can help you?'

## Colors

declare -r ALL_OFF="\e[0m"
declare -r BOLD="\e[1m"
declare -r RED="${BOLD}\e[31m"
declare -r GREEN="${BOLD}\e[32m"
declare -r YELLOW="${BOLD}\e[33m"
declare -r BLUE="${BOLD}\e[34m"

## Common values

declare -ar FZF_COMMON_OPTIONS=(
    --bind='esc:abort'
    --border-label=" CachyOS Recovery "
    --border=rounded
    --header-first
    --no-info
    --no-multi
    --no-sort
    --margin="15%,20%"
    --pointer=">"
    --prompt="Recovery > "
    --reverse
)

declare -a OVERLAY_FILES=(
    "/usr/local/bin/cachyos-recovery"
    "/usr/local/bin/cachyos-recovery-notifier"
    "/usr/lib/initcpio/hooks/overlayfs"
    "/usr/lib/initcpio/install/overlayfs"
    "/usr/lib/systemd/system/overlayfs-hook.service"
)

## Functions

function ask_yes_no(){
    local question="${1}"
    local answer=""

    while ! printf '%s' "${answer}" | grep -q '^\([Yy]\(es\)\?\|[Nn]\(o\)\?\)$'; do
        printf '%s' "${question} [Y]es/[N]o: "
        read -r answer
    done

    if printf '%s' "${answer}" | grep -q '^[Nn]\(o\)\?$'; then
        return 1
    fi
}

function msg() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${GREEN}==>${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

function info() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${YELLOW} -->${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

function step() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${BLUE}   -->${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

function error() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${RED}==> ERROR:${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

function die() {
    (($#)) && error "$@"
    exit 1
}

function show_error() {
    local header="$1"
    local description="$2"

    local -a opts=(
        "${FZF_COMMON_OPTIONS[@]}"
        --disabled
        --header="ERROR: ${header}"
        --preview-label=" Error details "
        --preview-window='down,65%,wrap'
        --preview='printf "%s\n" "$FZF_ERROR_DESCRIPTION"'
        --prompt=""
        --read0
    )

    printf '%s\0' "Back to recovery menu" \
        | FZF_ERROR_DESCRIPTION="$description" \
        fzf "${opts[@]}" >/dev/null || true

    return 0
}

function mount_overlay() {
    local source="${1}"
    local target="${2}"
    local mountpoint="${3}"

    if ! mount -t tmpfs cowspace "${target}"; then
        echo "Failed to mount tmpfs"
        return 1
    fi

    if ! mkdir -p "${target}/work" "${target}/upper"; then
        echo "Failed to create upper and work dirs"
        umount "${target}" || true
        return 1
    fi

    if ! mount -t overlay overlay \
        -o lowerdir="${source}",upperdir="${target}"/upper,workdir="${target}"/work \
        "${mountpoint}"; then
        rmdir "${target}/work" "${target}/upper"
        umount "${target}" || true
        echo "Failed to mount overlayfs"
        return 1
    fi

    return 0
}

# Make sure we're generating initramfs using snapshot configuration
function mount_snapshot() {
    local snapshot="$1"
    local device="${2}"
    local mountpoint="${3:-"/snapshot"}"
    local error

    if ! error="$(mkdir -p "${mountpoint}")"; then
        echo "Failed to create mountpoint for snapshot ${snapshot}: ${error}"
        return 1
    fi

    if ! error="$(mount -o "ro,subvolid=${snapshot}" "${device}" "$mountpoint" 2>&1)"; then
        echo "Failed to mount snapshot ${snapshot}: ${error}"
        return 1
    fi

    mount --bind /run "$mountpoint"/run || { echo "Failed to bind mount /run"; return 1; }
    mount --bind /tmp "$mountpoint"/tmp || { echo "Failed to bind mount /tmp"; return 1; }
    mount --rbind /dev "$mountpoint"/dev || { echo "Failed to bind mount /dev"; return 1; }
    mount --make-rslave "$mountpoint"/dev || { echo "Failed to make rslave /dev"; return 1; }
    mount --types proc /proc "$mountpoint"/proc || { echo "Failed to mount /proc"; return 1; }
    mount --rbind /sys "$mountpoint"/sys || { echo "Failed to bind mount /sys"; return 1; }
    mount --make-rslave "$mountpoint"/sys || { echo "Failed to make rslave /sys"; return 1; }
    return 0
}

# Fallback in case if we don't have ESP partition backup within
# snapshot or it doesn't reliable enough.
function generate_temporary_initramfs() {
    local snapshot="$1"
    local kver="$2"
    local workdir="$3"
    local error dest

    if ! error="$(mkdir -p "${workdir}/overlay" 2>&1)"; then
        echo "Failed to create overlay directory: ${error}"
        return 1
    fi

    # Yes, we're using overlayfs to add hook to create overlayfs...
    if ! error="$(mount_overlay "${snapshot}/usr" "${workdir}/overlay" "${snapshot}/usr")"; then
        rmdir "${workdir}/overlay"
        echo "Failed to create overlayfs hook: ${error}"
        return 1
    fi

    for hook in "${OVERLAY_FILES[@]}"; do
        dest="${snapshot}${hook}"
        if ! error="$(mkdir -p -- "${dest%/*}" 2>&1)"; then
            umount "${snapshot}/usr" && umount "${workdir}/overlay" && rmdir "${workdir}/overlay"
            echo "Failed to create directory for hook '${hook}' in chroot: ${error}"
            return 1
        fi

        if ! error="$(cp -- "${hook}" "${dest}" 2>&1)"; then
            umount "${snapshot}/usr" && umount "${workdir}/overlay" && rmdir "${workdir}/overlay"
            echo "Failed to copy hook '${hook}' in chroot: ${error}"
            return 1
        fi
    done

    if ! error="$(chroot "${snapshot}" mkinitcpio \
        -g "${workdir}/initramfs" \
        -k "$kver" \
        -A overlayfs 2>&1
    )"; then
        umount "${snapshot}/usr" && umount "${workdir}/overlay" && rmdir "${workdir}/overlay"
        echo "$error"
        return 1
    fi

    if ! umount "${snapshot}/usr"; then
        echo "Failed to unmount /usr overlay" >&2
        return 1
    fi

    if ! umount "${workdir}/overlay"; then
        echo "Failed to unmount tmpfs" >&2
        return 1
    fi

    rmdir "${workdir}/overlay" || return 1
    echo "${workdir}/initramfs"
    return 0
}

function boot_btrfs_snapshot() {
    local snapshot \
        kernel \
        tmp \
        vmlinux \
        initramfs \
        cmdline \
        error \
        kver \
        mountpoint

    msg "Trying to boot Btrfs snapshot"

    if ! snapshot="$(select_btrfs_snapshot "Select Btrfs snapshot to boot")"; then
        return 0
    fi

    mountpoint="/snapshot"
    device="$(findmnt -vno SOURCE /sysroot)"

    if [[ -z "$device" || ! -b "${device}" ]]; then
        die "Failed to get real device of root file system"
    fi

    if ! error="$(mount_snapshot "${snapshot}" "${device}" "${mountpoint}")"; then
        umount -R "${mountpoint}" || true
        show_error "Failed to mount snapshot directory" "${error}"
        return 1
    fi

    if ! kernel="$(select_kernel "$mountpoint")"; then
        umount -R "${mountpoint}"
        return 0
    fi

    IFS=$'\t' read -r _ kver <<< "${kernel}"

    if ! tmp="$(mktemp -d -t initramfs.XXXXXX 2>&1)"; then
        umount -R "${mountpoint}"
        show_error "Failed to create temporary directory" "${tmp}"
        return 1
    fi

    vmlinux="${mountpoint}/usr/lib/modules/${kver}/vmlinuz"

    step "Generating temporary initramfs to boot..."
    if ! initramfs="$(generate_temporary_initramfs \
        "$mountpoint" \
        "$kver" \
        "$tmp"
    )"; then
        umount -R "${mountpoint}" && rm -rf "${tmp}"
        show_error "Failed to generate temporary initramfs" \
            "${initramfs}"
        return 1
    fi

    cmdline="$(cat /proc/cmdline \
        | tr ' ' '\n' \
        | sed -e 's|^rw$|ro|g' \
        -e "s|^rootflags=.*$|rootflags=subvolid=${snapshot}|g" \
        -e '/^crashkernel=256M$/d' \
        -e '/^rd.systemd.unit=cachyos-recovery.target$/d' \
        -e '/^break=postmount$/d' \
        | tr '\n' ' '
    )"

    step "Loading kernel image to boot..."
    if ! error="$(kexec -l "$vmlinux" \
        --initrd="$initramfs" \
        --command-line="${cmdline} SYSTEMD_SULOGIN_FORCE=1 irqpoll reset_devices" 2>&1
    )"; then
        umount -R "${mountpoint}" && rm -rf "${tmp}"
        show_error "Failed to load kernel image using kexec" "${error}"
        return 1
    fi

    umount -R "${mountpoint}" && rm -rf "${tmp}"
    umount -R /sysroot || true
    kexec --exec
    return 0
}

function get_btrfs_snapshots() {
    local snapshots output
    local root="${1}"

    if ! output="$(btrfs subvolume list -r -s "${root}" 2>&1)"; then
        echo "Failed to get Btrfs snapshots: ${output}"
        return 1
    fi

    if [[ -z "$output" ]]; then
        echo "No snapshots were found"
        return 1
    fi

    if ! snapshots="$(
        # TODO: Switch to JSON format when will be available
        echo "${output}" | awk '
            /^ID [0-9]+ / {
                date_pos = index($0, " otime ")
                path_pos = index($0, " path ")

                if (!date_pos || path_pos <= date_pos)
                    next

                id = $2
                date = substr($0, date_pos + 7,
                              path_pos - date_pos - 7)
                path = substr($0, path_pos + 6)

                printf "%s\t%s\t%s\n", id, date, path
            }
        '
    )"; then
        echo "${snapshots}"
        return 1
    fi

    echo "${snapshots}"
}

function select_kernel() {
    local snapshot="${1}"
    local pkgbase kver kernel
    local -a opts=(
        "${FZF_COMMON_OPTIONS[@]}"
        --delimiter='\t'
        --header="Select kernel from snapshot to boot"
        --with-nth=1
        --read0
    )

    while read -r kver; do
        pkgbase="$(cat "${snapshot}/usr/lib/modules/${kver}/pkgbase")"
        printf "%s\t%s\0" "${pkgbase}" "${kver}"
    done < <(get_installed_kernels "${snapshot}") | fzf "${opts[@]}"
}

function select_btrfs_snapshot() {
    local snapshots_or_error
    local selected
    local header="${1}"

    if ! snapshots_or_error="$(get_btrfs_snapshots /sysroot)"; then
        show_error "Failed to get Btrfs snapshots" "${snapshots_or_error}"
        return 1
    fi

    local -a opts=(
        "${FZF_COMMON_OPTIONS[@]}"
        --delimiter='\t'
        --exact
        --header="${header}"
        --preview-window='wrap'
        --with-shell='/usr/bin/bash -c'
        --preview="$(cat <<'EOF'
subvol_id={1} date={2} path={3}
echo "Btrfs Subvolume ID: ${subvol_id}"
echo "Date: ${date}"
echo "Path: ${path}"

snapper_info="/sysroot/${path%/snapshot}/info.xml"
if [[ ! -e "${snapper_info}" ]]; then
    exit 0
fi

echo -e "\nSnapper metadata:\n"

desc="$(grep -m1 -Po "^\s*<description>\K(.*)(?=</description>\$)" "$snapper_info")"
type="$(grep -m1 -Po "^\s*<type>\K(.*)(?=</type>\$)" "$snapper_info")"

# Decode XML format to represent Unicode characters
while [[ $desc =~ (&#x([[:xdigit:]]+)\;) ]]; do
    match="${BASH_REMATCH[1]}"
    hex="${BASH_REMATCH[2]}"
    printf -v char "\\U$hex"
    desc="${desc//"$match"/$char}"
done

echo "Description: ${desc}"
echo "Type: ${type}"
EOF
)"
    )

    if ! selected="$(echo "${snapshots_or_error}" | fzf "${opts[@]}")"; then
        return 1
    fi

    if [[ -z "$selected" ]]; then
        return 1
    fi

    echo "${selected}" | cut -f 1
}

get_installed_kernels() {
    local root="${1:-""}"
    LC_ALL=C.UTF-8 find "${root}"/usr/lib/modules -maxdepth 2 -type f -regex ".*/pkgbase$" \
        | grep -Po "^${root}/usr/lib/modules/\K(.*)(?=/pkgbase$)" \
        | uniq \
        | sort
}

function regenerate_bootloader_config() {
    local esp="${1}"
    local chroot="${2}"

    if [[ -e "${chroot}/${esp}/EFI/limine/limine_x64.efi" && -x "${chroot}/usr/bin/limine-update" ]]; then
        chroot "${chroot}" limine-update || {
            error "Failed to generate Limine config"
            return 1
        }
    elif [[ -e "${chroot}/${esp}/EFI/systemd/systemd-bootx64.efi" && -x "${chroot}/usr/bin/sdboot-manage" ]]; then
        chroot "${chroot}" sdboot-manage gen || {
            error "Failed to generate systemd-boot config"
            return 1
        }
    elif [[ -e "${chroot}/${esp}/EFI/refind/refind_x64.efi" ]]; then
        info "rEFInd does not require configuration update"
    elif [[ -n "$(compgen -G "${chroot}/${esp}/EFI/*/grubx64.efi")" && -x "${chroot}/usr/bin/grub-mkconfig" ]]; then
        chroot "${chroot}" grub-mkconfig -o /boot/grub/grub.cfg || {
            error "Failed to generate systemd-boot config"
            return 1
        }
    else
        error "Failed to detect bootloader and update its configuration"
        return 1
    fi

    return 0
}

function move_nested_subvolumes() {
    local old="${1}"
    local new="${2}"
    local subvol output

    if ! output="$(btrfs subvolume list -o "${old}" 2>&1)"; then
        error "Failed to find nested subvolumes: ${output}"
        return 1
    fi

    # No nested subvolumes found
    if [[ -z "$output" ]]; then
        return 0
    fi

    while IFS= read -r subvol; do
        [[ "$subvol" == *" path "* ]] || continue
        subvol="${subvol#* path }"
        subvol="${subvol#*/}"

        # Root of nested subvolume must have 2 inode and be empty.
        if [[ "$(stat -c '%i' "${new}/${subvol}" 2>/dev/null)" == 2 ]]; then
            rmdir "${new}/${subvol}" || return 1
        fi

        if [[ ! -d "${new}/${subvol}" ]]; then
            if ! mv -T -v -- "${old}/${subvol}" "${new}/${subvol}"; then
                error "Failed to move ${subvol}"
                return 1
            fi
        else
            error "Subvolume already exists: ${new}/${subvol}"
            return 1
        fi
    done <<< "$output"

    return 0
}

function cleanup_boot() {
    local root="${1}"
    local kernels="${2}"
    local kernel kver file filename vmlinux output salt
    local -A versions=()
    local -A names=()
    local -A salts=()
    local -i signing_needed=0

    while read -r kver; do
        kernel="$(cat "${root}/usr/lib/modules/${kver}/pkgbase")"
        salt="$(md5sum -- "${root}/usr/lib/modules/${kver}/vmlinuz")"
        salt="${salt%% *}"
        [[ -n "$salt" ]] && salts["$salt"]="$kernel"
        names["$kernel"]="true"
        versions["$kver"]="true"
    done <<< "$kernels"

    if is_signing_needed "${root}"; then
        signing_needed=1
    fi

    while read -r file; do
        [[ -s "${file}" ]] || continue

        filename="${file##*/}"
        [[ "${filename}" != cachyos-recovery.efi ]] || continue

        case "${filename}" in
            vmlinuz-*|vmlinuz) # vmlinux files
                kernel="${filename#vmlinuz-}"
                salt="$(md5sum -- "${file}")"
                salt="${salt%% *}"
                if [[ -z "${names[$kernel]:-}" && -z "${salts[$salt]:-}" ]]; then
                    step "${filename} is no longer associated with package, so it will be removed"
                    rm -f "${file}"
                else
                    if ((signing_needed)); then
                        if ! chroot "${root}" sbctl sign -s "${file}"; then
                            error "Failed to sign file ${file}"
                        fi
                    fi
                fi
                ;;
            initramfs-*.img|initramfs|*.efi) # intiramfs
                if ! output="$(lsinitcpio "$file" 2>/dev/null)"; then
                    continue
                fi

                kver=""
                while IFS= read -r line; do
                    if [[ "$line" =~ ^usr/lib/modules/([^/]+)(/|$) ]]; then
                        kver="${BASH_REMATCH[1]}"
                        break
                    fi
                done <<< "$output"

                [[ -n "${kver}" ]] || continue

                if [[ -n "${versions[$kver]:-}" ]]; then
                    if ((signing_needed)); then
                        if ! chroot "${root}" sbctl sign -s "${file}"; then
                            error "Failed to sign file ${file}"
                        fi
                    fi
                    continue
                fi

                step "${filename} is no longer associated with package, so it will be removed"

                if [[ -e "${root}/boot/EFI/limine/limine_x64.efi" \
                    && -x "${root}/usr/bin/limine-entry-tool" \
                    && "$filename" == "initramfs" ]]
                then
                    kernel="${file%/*}"
                    kernel="${kernel##*/}"
                    if ! chroot "${root}" limine-entry-tool --remove-all "$kernel"; then
                        error "Failed to remove Limine boot entry, this is non-critical, but you will not be able to boot in ${kver}"
                    fi
                else
                    rm -f -- "${file}"
                fi
                ;;
        esac
    done < <(LC_ALL=C.UTF-8 find "${root}/boot" -type f \
        \( -name 'vmlinuz-*' \
        -o -name 'vmlinuz' \
        -o -name 'initramfs-*.img' \
        -o -name 'initramfs' \
        -o -iname '*.efi' \)
    )

    return 0
}

function is_signing_needed() {
    local chroot="${1}"
    local -i keys=0
    local status section

    if [[ ! -x "${chroot}/usr/bin/sbctl" ]]; then
        info "sbctl is not installed, skipping signing..."
        return 1
    fi

    if ! status="$(chroot "$chroot" sbctl status --json)"; then
        return 1
    fi

    if ! [[ "$status" =~ \"installed\"[[:space:]]*:[[:space:]]*true ]]; then
        info "sbctl is not installed, skipping signing..."
        return 1
    fi

    if ! [[ "$status" =~ \"secure_boot\"[[:space:]]*:[[:space:]]*true ]]; then
        info "Secure boot is not enabled, skipping signing..."
        return 1
    fi

    if ! [[ "$status" =~ \"setup_mode\"[[:space:]]*:[[:space:]]*false ]]; then
        info "Setup mode is enrolled, skipping signing..."
        return 1
    fi

    while IFS= read -r line; do
        case "$line" in
            PK:|KEK:|DB:) section="${line%:}";;
            ' '*|$'\t'*)
                if [[ -n "$section" ]]; then
                    ((keys++))
                    section=
                fi
                ;;
            *) ;;
        esac
    done < <(chroot "${chroot}" sbctl list-enrolled-keys || true)

    if ((keys != 3)); then
        info "No keys enrolled, skipping signing..."
        return 1
    fi

    return 0
}

function regenerate_boot_files() {
    local boot="${1}"
    local chroot="${2}"
    local esp="${3:-/boot}"
    local kernels="${4}"
    local kernel pkgver initramfs_generator kernels

    step "Regenerating new /boot files for snapshot..."

    if [[ -z "${boot:-}" ]]; then
        error "Temporary directory must be specified"
        return 1
    fi

    if ! mkdir -p "${boot}/overlay"; then
        error "Failed to create overlay directory"
        return 1
    fi

    if ! mkdir -p "${boot}/content"; then
        error "Failed to create temp content directory"
        return 1
    fi

    if ! cp -a -T -- "${chroot}"/boot "${boot}/content"; then
        error "Failed to copy /boot to ${boot}/content"
        return 1
    fi

    if ! mount_overlay "${boot}/content" "${boot}/overlay" "${chroot}/boot"; then
        error "Failed to create overlay mount for /boot"
        return 1
    fi

    # Fixes annoying fontconfig cache errors if mkinitcpio config has plymouth
    # hook enabled
    if ! mount -t tmpfs cowspace "${chroot}/var/cache"; then
        error "Failed to mount tmpfs for cache in chroot"
        umount "${chroot}/boot" || error "Failed to unmount /boot overlay"
        return 1
    fi

    if [[ -x "${chroot}/usr/share/libalpm/scripts/limine-mkinitcpio-install" ]]; then
        initramfs_generator="/usr/share/libalpm/scripts/limine-mkinitcpio-install"
    else
        initramfs_generator="/usr/share/libalpm/scripts/mkinitcpio install"
    fi

    while read -r pkgver; do
        echo "/usr/lib/modules/${pkgver}/vmlinuz" | chroot "${chroot}" $initramfs_generator || {
            error "Failed to re-generate initramfs for snapshot, rollback is not possible"
            umount "${chroot}/boot" || error "Failed to unmount /boot overlay"
            return 1
        }
    done <<< "$kernels"

    step "Purging orphan entities and signing new images if needed..."
    cleanup_boot "${chroot}" "${kernels}" || true

    if ! regenerate_bootloader_config "${esp}" "${chroot}"; then
        error "Failed to re-generate bootloader configuration, rollback is not possible"
        umount "${chroot}/boot" || error "Failed to unmount /boot overlay"
        return 1
    fi

    if ! umount "${chroot}/var/cache"; then
        error "Failed to unmount cache directory for mkinitcpio"
        umount "${chroot}/boot" || error "Failed to unmount /boot overlay"
        return 1
    fi

    if ! umount "${chroot}/boot"; then
        error "Failed to unmount /boot overlay"
        return 1
    fi

    return 0
}

function create_new_btrfs_root() {
    local tmp="${1}"
    local device="${2}"
    local rollback="${3}"

    if ! mkdir -p -- "${tmp}/root"; then
        error "Failed to create ${tmp}/root"
        return 1
    fi

    if ! mount -o subvolid=5 "${device}" "${tmp}/root"; then
        rmdir "${tmp}/root" || true
        error "Failed to mount old root partiton"
        return 1
    fi

    if ! btrfs --quiet subvolume snapshot "${tmp}/snapshot" "${rollback}"; then
        umount "${tmp}/root" && rmdir "${tmp}/root" || true
        error "Failed create new root from snapshot"
        return 1
    fi

    return 0
}

function is_whiteout() {
    local file="${1}"
    [[ -c "${file}" && "$(stat -c '%t:%T' "${file}")" == "0:0" ]] && return 0
    getfattr -n trusted.overlay.whiteout "${file}" &>/dev/null && return 0
    return 1
}

function copy_boot_files() {
    local upper="${1}"
    local src_dir="${2}"
    local dest_dir="${3}"
    local src dest

    while IFS= read -rd '' file; do
        src="${src_dir}/${file}"
        dest="${dest_dir}/${file}"

        if is_whiteout "$src" || [[ ! -e "$src" ]]; then
            if [[ -d "$dest" ]]; then
                rm -rf -- "$dest" || error "Failed to remove ${file}"
            else
                rm -f -- "$dest" || error "Failed to remove ${file}"
            fi
            continue
        fi

        if ! mkdir -p -- "$(dirname -- "$dest")"; then
            error "Failed to create parent directory for ${dest}"
            return 1
        fi

        if ! cp -a -T -- "$src" "$dest"; then
            error "Failed to copy ${src} file to ${dest}"
            return 1
        else
            sync "$dest"
        fi
    done < <(LC_ALL=C.UTF-8 find "${upper}" -mindepth 1 ! -type d -printf "%P\0")

    return 0
}

function rollback_btrfs_snapshot_wrapper() {
    local -a opts=(
        "${FZF_COMMON_OPTIONS[@]}"
        --header="Snapshot rollback completed. Do you want reboot?"
        --read0
    )

    msg "Rolling back of Btrfs snapshot"

    if ! snapshot="$(select_btrfs_snapshot "Select Btrfs snapshot to rollback")"; then
        return 0
    fi

    if ! rollback_btrfs_snapshot "${snapshot}" "/sysroot"; then
        error "Failed to rollback Btrfs snapshot. Press enter to return in main menu."
        read -r _
        return 1
    fi

    if ! answer="$(printf '%s\0' "No, go back" "Yes, reboot" | fzf "${opts[@]}")"; then
        return 0
    fi

    if [[ "$answer" == "Yes, reboot" ]]; then
        system_reboot
    fi

    return 0
}

function find_esp_partition() {
    local root="${1}"
    local esp

    while IFS= read -r target; do
        case "$target" in
            /boot|/boot/efi|/efi)
                esp="$target"
                break
                ;;
        esac
    done < <(findmnt --fstab \
        --types vfat \
        --tab-file "${root}/etc/fstab" \
        --noheadings \
        --output TARGET || true
    )

    echo "${esp:-}"
}

function rollback_btrfs_snapshot() {
    local fstype \
        tmp \
        source \
        snapshot \
        device \
        esp \
        oldroot \
        rollback \
        boot \
        kernels
    local -i completed=0
    local snapshot="${1:-}"
    local root="${2:-"/"}"

    # Stage 0: Preparing

    if [[ -z "$snapshot" ]]; then
        snapshot="$(cat /proc/cmdline \
            | tr ' ' '\n' \
            | grep -Pox "rootflags=subvolid=\K([0-9]+)"
        )"
    fi

    if ! [[ "$snapshot" =~ ^[0-9]+$ ]]; then
        error "You have not specified correct ID and not booted in snapshot"
        return 1
    fi

    if ! ask_yes_no "Are you really want to restore this snapshot?"; then
        return 0
    fi

    msg "Starting snapshot rollback..."

    device="$(findmnt -vno SOURCE "${root}" 2>/dev/null)"

    # Find root if we're booted in snapshot
    if [[ "${device}" == "overlay" ]]; then
        device="$(findfs "$(
            cat /proc/cmdline \
            | tr ' ' '\n' \
            | grep -Po "root=\K((UUID|PARTUUID|LABEL|PARTLABEL)=(.*))"
            )"
        )"
    fi

    if [[ -z "$device" || ! -b "${device}" ]]; then
        error "Failed to get real device of root file system"
        return 1
    fi

    if ! tmp="$(mktemp -d -t mount.XXXXXX)"; then
        error "Failed to create temporary mount directory"
        return 1
    fi

    if ! boot="$(mktemp -d -t boot.XXXXXX)"; then
        rmdir "${tmp}"
        error "Failed to create temporary boot directory"
        return 1
    fi

    function _cleanup_rollback() {
        [[ -z "${tmp:-}" ]] && return 0
        if mountpoint -q "${tmp}/root" 2>/dev/null; then
            # Re-incorporate nested volumes on fail
            if [[ -n "${oldroot:-}" && -d "${oldroot}" && "$completed" != "1" ]]; then
                if [[ ! -d "${rollback}" ]]; then
                    move_nested_subvolumes "${tmp}/root/@" "${oldroot}" || {
                        error "Failed to restore nested subvolumes, your system may be broken"
                        return 1
                    }
                    mv -T -- "${tmp}/root/@" "${rollback}" || {
                        error "Failed to move new root, your system may be broken"
                        return 1
                    }
                fi
                mv -T -- "${oldroot}" "${tmp}/root/@" || {
                    error "Failed to restore old root, your system may be broken"
                    return 1
                }
            fi

            if [[ -n "${rollback:-}" && -d "${rollback}" ]]; then
                btrfs --quiet subvolume delete --commit-after "${rollback}" || true
            fi

            umount "${tmp}/root" && rmdir "${tmp}/root"
        fi

        mountpoint -q "${tmp}/snapshot" 2>/dev/null && umount -R "${tmp}/snapshot" 2>/dev/null
        mountpoint -q "${tmp}/snapshot" 2>/dev/null || rmdir "${tmp}/snapshot" 2>/dev/null
        rmdir "${tmp}" 2>/dev/null || true
        [[ ! -d "${boot}" ]] && return 0
        mountpoint -q "${boot}/overlay" 2>/dev/null && umount "${boot}/overlay" 2>/dev/null
        mountpoint -q "${boot}/overlay" 2>/dev/null || rmdir "${boot}/overlay" 2>/dev/null
        rm -rf "${boot}/content" && rmdir "${boot}"
    }

    trap '_cleanup_rollback' EXIT RETURN

    # Stage 1: Try to check if we can regenerate all boot files before
    # restoring snapshot
    if ! mount_snapshot "${snapshot}" "${device}" "${tmp}/snapshot"; then
        error "Failed to mount snapshot"
        return 1
    fi

    esp="$(find_esp_partition "${tmp}/snapshot")"

    # We don't support any other ESP locations expect /boot, /efi and /boot/efi
    # in CachyOS.
    if [[ -z "${esp}" ]]; then
        error "No ESP partition was found to mount"
        return 1
    fi

    if ! kernels="$(get_installed_kernels "${tmp}/snapshot")"; then
        error "Failed to find installed kernels in snapshot"
        return 1
    fi

    if [[ -z "$kernels" ]]; then
        error "No kernels were found in snapshot"
        return 1
    fi

    if ! chroot "${tmp}/snapshot" mount "$esp"; then
        error "Failed to mount ${esp} partition"
        return 1
    fi

    # Do not regenerate boot files if ESP partition is not supposed to be
    # mount in /boot. This is only possible for GRUB.
    if [[ "$esp" == "/boot" ]]; then
        if ! regenerate_boot_files "${boot}" "${tmp}/snapshot" "${esp}" "${kernels}"; then
            error "Failed to regenerate boot files, snapshot isn't recoverable"
            return 1
        fi

        info "Generated new /boot files, starting snapshot restore..."
    fi

    # Stage 2: Create new root from snapshot
    rollback="$(mktemp -t -u -p "${tmp}/root" '@rollback.XXXXXXX')"

    step "Creating new root subvolume from the snapshot..."

    if ! create_new_btrfs_root "${tmp}" "${device}" "${rollback}"; then
        error "Failed to restore snapshot, old root preserved"
        return 1
    fi

    # Stage 3: Make new root
    oldroot="$(mktemp -t -u -p "${tmp}/root" '@oldroot.XXXXXXX')"
    step "Moving new root in place of the old one..."

    if ! mv -T -- "${tmp}/root/@" "${oldroot}"; then
        error "Failed to move old root"
        return 1
    fi

    if ! mv -T -- "${rollback}" "${tmp}/root/@"; then
        error "Failed to move new root"
        return 1
    fi

    # Stage 4: Move all nested subvolumes
    step "Moving nested subvolumes from old root to new one..."
    if ! move_nested_subvolumes "${oldroot}" "${tmp}/root/@"; then
        error "Failed to move nested subvolumes, old root preserved"
        return 1
    fi

    # Stage 5: Move staged files to real /boot
    if [[ "$esp" == "/boot" ]]; then
        step "Copying new /boot files to ESP partition..."
        if ! copy_boot_files "${boot}/overlay/upper" "${boot}/overlay/upper" "${tmp}/snapshot/boot"; then

            # Revert changes back from lowerdir of overlay, which is copy of real boot
            if ! copy_boot_files "${boot}/overlay/upper" "${boot}/content" "${tmp}/snapshot/boot"; then
                error "Snapshot is restored, but your /boot is incosistient, so you have to fix it manually"
                completed=1
                return 0
            fi

            error "Failed to copy staged boot files in ESP partition, returning old root..."
            return 1
        fi

    fi

    # Remove pacman lock from snapshot after restoring
    rm -f "${tmp}/root/@/var/lib/pacman/db.lck"

    completed=1

    if ! btrfs --quiet subvolume delete --commit-after "${oldroot}"; then
        error "Failed to remove ${oldroot}"
    fi

    info "Snapshot restored, you can reboot your system"

    return 0
}

function system_reboot() {
    info "Rebooting the system..."
    umount /sysroot || true
    sync
    systemctl reboot
}

function script_exit() {
    exit 0
}

function start() {
    local -A actions=()
    local -A descriptions=()
    local -i count=1
    local fstype action preview_dir

    local -a opts=(
        "${FZF_COMMON_OPTIONS[@]}"
        --header="${RECOVERY_HEADER}"
        --preview-label=" Description "
        --preview-window='down,30%,wrap'
        --preview='cat -- "$FZF_PREVIEW_DIR"/{} 2>/dev/null || echo "No description"'
        --read0
    )

    # TODO: Prompt user to select root parition if it was not mounted
    fstype="$(findmnt -no FSTYPE /sysroot 2>/dev/null || true)"

    if [[ "$fstype" == "btrfs" ]]; then
        # Boot snapshot
        action="$((count++)). $BTRFS_BOOT_SNAPSHOT_LABEL"
        actions["${action}"]="boot_btrfs_snapshot"
        descriptions["${action}"]="$BTRFS_BOOT_SNAPSHOT_DESC"

        # Rollback snapshot
        action="$((count++)). $BTRFS_ROLLBACK_SNAPSHOT_LABEL"
        actions["$action"]="rollback_btrfs_snapshot_wrapper"
        descriptions["$action"]="$BTRFS_ROLLBACK_SNAPSHOT_DESC"
    fi

    # System reboot
    action="$((count++)). $SYSTEM_REBOOT_LABEL"
    actions["$action"]="system_reboot"
    descriptions["$action"]="$SYSTEM_REBOOT_DESC"

    # Exit
    action="$((count++)). $EXIT_LABEL"
    actions["$action"]="script_exit"
    descriptions["$action"]="$EXIT_DESC"

    # Create previews with descriptions
    preview_dir="$(mktemp -d -t preview.XXXXXX)"

    if [[ -e "$preview_dir" ]]; then
        for action in "${!actions[@]}"; do
            echo "${descriptions[$action]}" > "${preview_dir}/${action}"
        done
    fi

    while true; do
        if ! action="$(
            printf '%s\0' "${!actions[@]}" \
            | sort -t '.' -n -k 1 -z \
            | FZF_PREVIEW_DIR="${preview_dir}" fzf "${opts[@]}"
        )"; then
            break
        fi

        msg "Selected: ${action}"

        if [[ -z "$action" ]]; then
            continue
        fi

        "${actions[$action]}" || true
    done

    [[ -n "${preview_dir}" && -d "${preview_dir}" ]] && rm -rf -- "${preview_dir}"
}

function usage() {
    cat <<EOF
${0##*/} <ACTION>

CachyOS recovery utility

Actions:
    start      Start system recovery process
    rollback   Rollback Btrfs snapshot
EOF
}

function main() {
    if [[ "$EUID" -ne 0 ]]; then
        die "Please, run script as root"
    fi

    if [[ "${1:-}" == "--debug" ]]; then
        set -x
        shift
    fi

    case "${1:-}" in
        start)
            start
            ;;
        rollback)
            rollback_btrfs_snapshot "${@:2:$#}"
            ;;
        *)
            usage
            return 1
            ;;
    esac
}

main "$@"
