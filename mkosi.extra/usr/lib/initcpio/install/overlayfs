build() {
	map add_module btrfs overlay
	map add_binary \
        bash \
        btrfs \
        findmnt \
        logger \
        /usr/local/bin/cachyos-recovery \
        /usr/local/bin/cachyos-recovery-notifier

    if command -v add_systemd_unit &>/dev/null; then
        add_binary /usr/lib/initcpio/hooks/overlayfs
        add_systemd_unit overlayfs-hook.service
        add_symlink \
            '/usr/lib/systemd/system/initrd.target.wants/overlayfs-hook.service' \
            '/usr/lib/systemd/system/overlayfs-hook.service'
    else
        add_runscript
    fi
}

help() {
    cat  <<HELPEOF
Mounts overlayfs when booting from read-only snapshot
HELPEOF
}
